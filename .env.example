# 运行环境变量示例，复制为 .env 并按需覆盖，不要提交真实密钥
SERVER_PORT=8080

# demo 使用 H2 文件库，无需以下数据库配置；prod 必须提供
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fund_platform
DB_USERNAME=fund
DB_PASSWORD=

# JWT 签名密钥，长度不少于 32 字节；prod 缺失将启动失败
JWT_SECRET=

# prod 首次启动且不存在管理员时使用，用于创建 admin 账号
ADMIN_INIT_PASSWORD=

# 附件存储目录
UPLOAD_DIR=./storage

# 允许跨域访问的前端地址，多个用逗号分隔
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 大模型（可选，OpenAI 兼容接口；默认关闭，密钥不要提交）
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=deepseek-flash
LLM_API_KEY=

